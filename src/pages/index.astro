---
import Layout from '../layouts/layout.astro';
import { getEntry } from 'astro:content';
const allSquares = (await getEntry('cards', 'ffxiv'))?.data.squares ?? [];
const numSquares = 16;
---

<Layout title='ffxiv bingo' description='bingo card for events that may occur in your playthrough of critically acclaimed mmorpg final fantasy xiv'>
  <div class='flex justify-center'>
    <div class='max-w-2xl min-w-md mx-3'>
      <div id='bingo-grid' class='grid grid-cols-4 gap-2 bg-white rounded p-3'></div>
      <div class='flex justify-center mt-5'>
        <button id='bingo-reset' class='px-3 py-1 text-lg rounded bg-cyan-950'>reset</button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ allSquares, numSquares }}>
  const STORAGE_KEY = 'bingo:ffxiv';
  const CELL_CLASS = 'p-1 border rounded border-black text-black aspect-square text-center place-content-center cursor-pointer';

  function randomizeSquares(source, n) {
    const filled = [];
    while (source.length && filled.length < n) {
      filled.push(...shuffle([...source]));
    }
    filled.splice(n);
    shuffle(filled);
    return filled;
  }

  function shuffle(array) {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed?.squares) || !Array.isArray(parsed?.checked)) return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function saveState(state) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function freshState() {
    return { squares: randomizeSquares(allSquares, numSquares), checked: [] };
  }

  function render(state) {
    const grid = document.getElementById('bingo-grid');
    grid.replaceChildren();
    state.squares.forEach((text, i) => {
      const cell = document.createElement('button');
      cell.type = 'button';
      cell.className = CELL_CLASS;
      if (state.checked.includes(i)) cell.classList.add('checked');
      cell.textContent = text;
      cell.addEventListener('click', () => {
        const willCheck = !cell.classList.contains('checked');
        [...grid.children].forEach((node, j) => {
          if (node.textContent !== cell.textContent) return;
          node.classList.toggle('checked', willCheck);
          const idx = state.checked.indexOf(j);
          if (willCheck && idx === -1) state.checked.push(j);
          else if (!willCheck && idx !== -1) state.checked.splice(idx, 1);
        });
        saveState(state);
      });
      grid.appendChild(cell);
    });
  }

  let state = loadState();
  if (!state) {
    state = freshState();
    saveState(state);
  }
  render(state);

  document.getElementById('bingo-reset').addEventListener('click', () => {
    if (confirm('reset?')) {
      state = freshState();
      saveState(state);
      render(state);
    }
  });
</script>
